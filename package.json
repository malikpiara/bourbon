{
  "name": "burbbon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "electron:build-main": "tsc -p electron/tsconfig.json",
    "electron:prep": "node electron/prep.mjs && pnpm electron:build-main && node -e \"require('fs').cpSync('dist-electron','.electron-staging/dist-electron',{recursive:true})\"",
    "electron:dev": "pnpm build && pnpm electron:prep && electron .electron-staging/dist-electron/main.js",
    "electron:pack": "pnpm build && pnpm electron:prep && electron-builder --mac",
    "electron:pack-win": "pnpm build && pnpm electron:prep && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.octosolido.burbbon",
    "productName": "Burbbon",
    "directories": {
      "app": ".electron-staging",
      "output": "release",
      "buildResources": "electron"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.icns",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "npmRebuild": false,
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,css,json,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "pdfjs-dist": "4.8.69"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "pdfjs-dist": "4.8.69",
    "posthog-js": "^1.342.1",
    "react": "^19.2.4",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-pdf": "9.0.0",
    "react-pdf-tailwind": "^2.3.0",
    "react-phone-number-input": "^3.4.14",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.4.0+sha256.b6fd0bfda555e7e584ad7e56b30c68b01d5a04f9ee93989f4b93ca8473c49c74"
}
